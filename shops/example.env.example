# Template for one shop's config. Copy this to shops/<name>.env (e.g.
# shops/summercosta.env) and fill it in — that file is gitignored, this
# template isn't.
#
# Each shop should be its own Etsy Seller App (own keystring + shared
# secret) — don't reuse one app's key across shops.

# ── This shop's Etsy app (etsy.com/developers/your-apps) ──────────────
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Must match the redirect URI registered on this shop's Etsy app. Same
# value works across all shops since it's just where the local OAuth
# server listens during `npm run auth`.
ETSY_REDIRECT_URI=http://localhost:3003/oauth/redirect

# ── Filled in after `npm run auth -- --shop=<name>` ────────────────────
ETSY_SHOP_ID=
ETSY_REFRESH_TOKEN=

# ── Filled in after `npm run find-ids -- --shop=<name>` ────────────────
ETSY_SHIPPING_PROFILE_ID=
ETSY_READINESS_STATE_ID=
ETSY_DEFAULT_TAXONOMY_ID=
ETSY_WHO_MADE=i_did
ETSY_WHEN_MADE=2020_2026

# ── This shop's Listings sheet ──────────────────────────────────────────
# From the Sheet's URL: docs.google.com/spreadsheets/d/THIS_PART/edit
# Needs a "Listings" tab — see README.md "Set up this shop's Listings sheet".
GOOGLE_SHEET_ID=

# ── Only if this shop is routed through a proxy (IPRoyal/AdsPower) ────
# Leave blank for shops that use this machine's regular IP.
# Format: http://username:password@host:port
PROXY_URL=
